# Personal development mode. Shared deployments use deploy/multi-household/.env.example.
ENERGY_VOICE_MODE=personal
ASK_SKILL_ID=amzn1.ask.skill.replace-with-your-skill-id
IGW_URL=https://energy.example.com/v1/energy
IGW_READ_TOKEN=replace-with-a-scoped-read-token
# Set both Cloudflare values if the outbound IGW route uses Access.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
IGW_TIMEOUT_SECONDS=3
IGW_MAX_AGE_SECONDS=30

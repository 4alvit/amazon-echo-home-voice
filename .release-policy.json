{
  "repository": "4alvit/amazon-echo-home-voice",
  "mode": "release",
  "default_branch": "main",
  "validation_workflows": [
    "validate.yml",
    "test.yml",
    "codeql.yml",
    "dependency-review.yml",
    "security.yml",
    "workflow-validation.yml"
  ],
  "local_checks": [
    "bash scripts/ci.sh"
  ],
  "notes": [
    "Release payloads are installable source archives with integration templates and locked build requirements; no prebuilt image, hosted service, app-store admission or physical voice acceptance is implied.",
    "Python version matrix and webhook container tests remain required. No AWS/Alexa deployment or live voice requests.",
    "Includes both portable Cloudflare Terraform modules added on main; local and callable checks use disposable copies with backend disabled and never plan/apply.",
    "Quality gate is the sole push/PR entry point; reusable test workflows do not duplicate event-triggered runs."
  ],
  "visibility": "public",
  "terraform_roots": [
    "deploy/terraform/plan-a-worker-vpc",
    "deploy/terraform/plan-b-direct-tunnel"
  ],
  "schema": 1,
  "version_file": "pyproject.toml",
  "artifact_pattern": "release-assets*",
  "single_entry_ci": true,
  "release_notes": "CHANGELOG.md",
  "container_assets": {},
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "package": "amazon-echo-home-voice",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "artifacts": [
      {
        "path": "amazon-echo-home-voice-*.tar.gz",
        "format": "tar-toml",
        "member": "amazon-echo-home-voice/pyproject.toml",
        "field": "project.version",
        "package": "amazon-echo-home-voice",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "toolkit_revision": "5e413f80a4353d328b4529eae57992ac3987e2dd"
  },
  "fuzzing": {
    "toolkit_ref": "368320994ed55ae68935dcadb4062000a4648b92"
  }
}

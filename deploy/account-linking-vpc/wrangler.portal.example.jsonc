{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home-energy-portal-relay",
  "main": "relay.mjs",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ROLE": "portal",
    "PUBLIC_HOST": "home-energy-portal-relay.REPLACE_WITH_ACCOUNT_SUBDOMAIN.workers.dev"
  },
  "vpc_services": [
    {
      "binding": "BACKEND",
      "service_id": "REPLACE_WITH_EXACT_PORTAL_VPC_SERVICE_ID"
    }
  ]
}

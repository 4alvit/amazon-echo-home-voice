# Copy to .env with mode 0600. Use literal, unquoted KEY=value lines.
# Replace each replace-with value with an independently generated secret.
POSTGRES_PASSWORD=replace-with-a-random-database-password
KC_BOOTSTRAP_ADMIN_USERNAME=replace-with-an-initial-admin-username
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-random-bootstrap-password
KC_HOSTNAME=https://auth.example.com
ASK_SKILL_ID=amzn1.ask.skill.replace-with-your-skill-id
OAUTH_ISSUER=https://auth.example.com/realms/home-energy
OAUTH_AUTHORIZATION_URL=https://auth.example.com/realms/home-energy/protocol/openid-connect/auth
OAUTH_TOKEN_URL=https://auth.example.com/realms/home-energy/protocol/openid-connect/token
OAUTH_INTROSPECTION_URL=https://auth.example.com/realms/home-energy/protocol/openid-connect/token/introspect
OAUTH_ALEXA_CLIENT_ID=home-energy-alexa
OAUTH_ALEXA_CLIENT_SECRET=replace-with-a-random-alexa-client-secret
OAUTH_PORTAL_CLIENT_ID=home-energy-portal
OAUTH_PORTAL_CLIENT_SECRET=replace-with-a-different-random-portal-client-secret
OAUTH_PORTAL_REDIRECT_URI=https://connect.example.com/callback
TENANT_ENCRYPTION_KEY=replace-with-a-fernet-key
OAUTH_TIMEOUT_SECONDS=2

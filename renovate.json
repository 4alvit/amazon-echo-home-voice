{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "dockerfile",
    "pep621",
    "pip_requirements",
    "terraform"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ]
  },
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    ".github/requirements-build.txt",
    ".github/requirements-security.txt",
    "src/requirements.txt"
  ],
  "packageRules": [
    {
      "description": "Generated locks with unsupported compile flags or export headers are regenerated through their existing source workflow.",
      "matchFileNames": [
        ".github/requirements-build.txt",
        ".github/requirements-security.txt",
        "src/requirements.txt"
      ],
      "enabled": false,
      "matchManagers": [
        "pip_requirements"
      ]
    }
  ]
}
